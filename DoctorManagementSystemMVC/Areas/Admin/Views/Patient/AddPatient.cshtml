@model DoctorManagementSystemMVC.Models.Patient

@{
    ViewData["Title"] = "Add Patient";
}

<div class="container mt-5">
    <h2 class="text-center mb-4 text-primary">Add New Patient</h2>

    <form asp-area="Admin" asp-controller="Patient" asp-action="AddPatient" method="post" class="p-4 border rounded shadow-sm bg-light"
    enctype="multipart/form-data">
        <div class="mb-3">
            <label asp-for="Name" class="form-label fw-bold"></label>
            <input asp-for="Name" class="form-control" placeholder="Enter patient name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Img" class="form-label fw-bold"></label>
            <input type="file" form="form-file" asp-for="Img" class="form-control" />
            <span asp-validation-for="Img" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">Add Patient</button>
    </form>
</div>
