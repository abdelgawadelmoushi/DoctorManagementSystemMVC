@using DoctorManagementSystemMVC.Models.ViewModels
@model DocVM

<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
          crossorigin="anonymous">
</head>

<div class="container mt-4">
    <a asp-area="Admin"
       asp-controller="Patient"
       asp-action="AddPatient"
       class="btn btn-sm btn-danger mb-3">
        Add Patient
    </a>

    <h1 class="mb-4 text-center">Patients & Their Appointments</h1>

    @foreach (var doctor in Model.Doctors)
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">@doctor.DocName</h4>
                <small>@doctor.Specialization?.Name</small>
            </div>

            <div class="card-body bg-light">
                @{
                    var doctorAppointments = Model.Appointments
                    .Where(a => a.DoctorId == doctor.Id)
                    .ToList();
                }

                @if (doctorAppointments.Any())
                {
                    <table class="table table-striped table-bordered align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Patient Name</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appointment in doctorAppointments)
                            {
                                <tr>
                                    <td>@appointment.Patient?.Name</td>
                                    <td>@appointment.Date.ToShortDateString()</td>
                                    <td>@appointment.Time</td>
                                    <td>
                                        <a asp-area="Admin"
                                           asp-controller="Appointments"
                                           asp-action="Edit"
                                           asp-route-id="@appointment.Id"
                                           class="btn btn-sm btn-warning">
                                            Edit
                                        </a>
                                        <a asp-area="Admin"
                                           asp-controller="Appointments"
                                           asp-action="Delete"
                                           asp-route-id="@appointment.Id"
                                           class="btn btn-sm btn-danger">
                                            Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted text-center">No appointments available for this doctor.</p>
                }
            </div>
        </div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
