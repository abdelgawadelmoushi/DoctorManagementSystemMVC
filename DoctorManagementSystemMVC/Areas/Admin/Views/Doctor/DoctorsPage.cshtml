@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using DoctorManagementSystemMVC.Models
@model List<Doctor>

<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<div class="container">
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-4">
                <div class="card" style="width: 18rem;">
                    <img src="~/Images/@item.Img" class="card-img-top" alt="..." height="270PX">
                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text">@item.Specialization?.Name</p>
                        <a asp-area="Admin"
                           asp-controller="Doctor"
                           asp-action="CompleteAppointment"
                           asp-route-DoctorId="@item.Id"
                           class="btn btn-primary">
                            Book Appointment
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
