@model IEnumerable<DoctorManagementSystemMVC.Models.Doctor>

<h1>Doctors & Their Appointments</h1>
<div class="card mb-3">
  
@foreach (var doctor in Model)
{


        <div class="card-header">
            <h4>@doctor.DocName (@doctor.Specialization)</h4>
        </div>
    
        <div class="card-body">
            @if (doctor.Appointments.Any())
            {
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Patient Name</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appointment in doctor.Appointments)
                        {
                            <tr>
                                <td>@appointment.Name</td>
                                <td>@appointment.Date.ToShortDateString()</td>
                                <td>@appointment.Time</td>
                                <td>
                                    <a asp-area="Admin"
                                       asp-controller="Appointments"
                                       asp-action="Edit"
                                       asp-route-id="@appointment.Id"
                                       asp-route-doctorId="@doctor.Id"
                                       class="btn btn-sm btn-warning">
                                        Edit
                                    </a>
                                    <a asp-area="Admin"
                                       asp-controller="Appointments"
                                       asp-action="Delete"
                                       asp-route-id="@appointment.Id"
                                       class="btn btn-sm btn-danger btn-delete">
                                        Delete
                                    </a>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No appointments booked yet.</p>
            }
        </div>

}
</div>